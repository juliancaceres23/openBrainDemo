# ==========================================================
# .gitignore — Open Brain
# Nota: .gitignore NO afecta archivos que ya estén en Git.
# Si agregas una regla para algo ya subido, quítalo del
# índice con:  git rm -r --cached <ruta>
# ==========================================================

# --- Editores e IDE (configuración personal) ---
.idea/
.vscode/
*.iml
*.swp

# --- Sistema operativo ---
.DS_Store
Thumbs.db
desktop.ini

# --- Reglas de IA generadas por extensiones locales (Codacy) ---
.github/instructions/

# --- Variables de entorno y secretos privados (nunca subir) ---
# Los secretos del backend (RESEND_API_KEY, IP_SALT) se guardan en el panel de
# Cloudflare, nunca en el repositorio. Para pruebas locales con wrangler van en
# .dev.vars, que NO se sube.
.env
.env.*
!.env.example
.dev.vars
wrangler.toml
*.pem
*.key

# --- Dependencias, compilados y registros (por si se agregan en el futuro) ---
node_modules/
dist/
.wrangler/
*.log

# --- Archivos temporales y copias ---
*.tmp
*.bak
*~
